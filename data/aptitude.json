  "questions": [
    {
      "id": "AP-U1-0001", "part": "C", "subject": "aptitude", "unit": "1", "unit_name_ta": "திறனறிவு",
      "topic": "simplification", "topic_name_ta": "எளிமையாக்கல்", "difficulty": "easy",
      "question_ta": "12 + 8 × 3 − 4 இன் மதிப்பு என்ன?",
      "options_ta": ["60", "32", "56", "28"],
      "answer_index": 1,
      "explanation_ta": "BODMAS விதிப்படி பெருக்கல் முதலில்: 8 × 3 = 24. பிறகு 12 + 24 − 4 = 32. எனவே சரியான விடை 32. மற்ற விடைகள் செயல்வரிசையை தவறாகப் பயன்படுத்தினால் (எ.கா. இடமிருந்து வலமாக கூட்டி 60) கிடைக்கும் தவறான மதிப்புகள்.",
      "source_hint": "SSLC Maths", "is_current_affairs": false
    },
    {
      "id": "AP-U1-0002", "part": "C", "subject": "aptitude", "unit": "1", "unit_name_ta": "திறனறிவு",
      "topic": "percentage", "topic_name_ta": "விழுக்காடு", "difficulty": "easy",
      "question_ta": "200 இன் 25% எவ்வளவு?",
      "options_ta": ["25", "40", "50", "75"],
      "answer_index": 2,
      "explanation_ta": "25% என்பது 25/100 = 1/4. 200 × 1/4 = 50. எனவே விடை 50. 50 என்பது பாதி (50%); 25 என்பது விழுக்காட்டை நேரடியாக எடுத்த தவறு.",
      "source_hint": "SSLC Maths", "is_current_affairs": false
    },
    {
      "id": "AP-U1-0003", "part": "C", "subject": "aptitude", "unit": "1", "unit_name_ta": "திறனறிவு",
      "topic": "hcf_lcm", "topic_name_ta": "மீ.பொ.வ / மீ.பொ.ம", "difficulty": "medium",
      "question_ta": "12 மற்றும் 18 இன் மீப்பெரு பொது வகுத்தி (HCF) என்ன?",
      "options_ta": ["3", "6", "12", "36"],
      "answer_index": 1,
      "explanation_ta": "12 = 2×2×3, 18 = 2×3×3. பொதுவான காரணிகள் 2 மற்றும் 3 → HCF = 2×3 = 6. 36 என்பது மீ.பொ.ம (LCM), HCF அல்ல.",
      "source_hint": "SSLC Maths", "is_current_affairs": false
    },
    {
      "id": "AP-U1-0004", "part": "C", "subject": "aptitude", "unit": "1", "unit_name_ta": "திறனறிவு",
      "topic": "ratio_proportion", "topic_name_ta": "விகிதம் & விகிதசமம்", "difficulty": "medium",
      "question_ta": "ஒரு தொகையை 2:3 என்ற விகிதத்தில் பிரித்தால், மொத்தம் ₹500 எனில் பெரிய பங்கு எவ்வளவு?",
      "options_ta": ["₹200", "₹250", "₹300", "₹350"],
      "answer_index": 2,
      "explanation_ta": "மொத்த பங்குகள் = 2+3 = 5. ஒரு பங்கின் மதிப்பு = 500/5 = ₹100. பெரிய பங்கு = 3 × 100 = ₹300. சிறிய பங்கு = 2 × 100 = ₹200.",
      "source_hint": "SSLC Maths", "is_current_affairs": false
    },
    {
